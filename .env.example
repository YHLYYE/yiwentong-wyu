# 注意：密钥只填在 .env，不要填在 .env.example
# 复制为 .env 后填写；不要提交 .env
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 1=启用 bge-m3 + Faiss；没有 GPU/模型时可设 0，自动 BM25-only
WYU_USE_DENSE=1
# 1=强制离线原文摘录（不调用 LLM）；不填 key 也会自动离线
WYU_OFFLINE=0
# auto / cpu / cuda
WYU_DEVICE=auto
WYU_BM25_MIN=1.0
WYU_DENSE_MIN=0.65
# 离线兜底：问题关键词在 top 文档里的覆盖率低于该值就拒答
WYU_COVERAGE_MIN=0.5

# 可选：指定本地 bge-m3 目录（离线/内网环境推荐）
# WYU_MODEL_PATH=C:/models/bge-m3
# 可选：问答日志路径，默认 data/logs/qa_log.jsonl
# WYU_LOG_PATH=data/logs/qa_log.jsonl

# 可选：设置后 Streamlit 才要求演示密码；不设置直接进入
# WYU_DEMO_PASSWORD=
